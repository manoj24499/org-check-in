generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceMethod {
  QR // legacy — QR check-in was removed; kept so historical rows stay valid
  PIN
  // System-generated, not from a PIN entry — currently only used for the
  // auto-checkout when a TimedPermission runs through an employee's shift
  // end (see /api/kiosk/location). Kept distinct from PIN so an admin
  // reviewing history can tell the difference at a glance.
  AUTO
}

enum WorkMode {
  OFFICE
  WFH
  // Field workers: no geofence is enforced at check-in at all (see
  // /api/kiosk/scan) — home/office coordinates are irrelevant for this mode.
  FIELD
}

// Auto-computed at check-in (see /api/kiosk/scan) by comparing the check-in
// time against the employee's shiftStartTime. PERMISSION = up to 1 hour
// late, HALF_DAY = more than 1 hour late.
enum LeaveType {
  NONE
  PERMISSION
  HALF_DAY
}

// The choice a FIELD-workMode employee makes at check-in each day — Office
// (geofenced against the shared OfficeLocation, same as regular OFFICE
// employees) or Field (no geofence, distance/visit tracking active). See
// /api/kiosk/scan.
enum CheckInMode {
  OFFICE
  FIELD
}

// Outcome of calling the external face-verification service at check-in
// (see lib/faceVerify.ts) — recorded regardless of whether it blocked the
// check-in, so an admin reviewing history can see whether verification even
// ran. NOT_CHECKED covers both "employee isn't enrolled" and "no photo was
// submitted"; UNAVAILABLE means the service was unreachable/timed out, which
// (per /api/kiosk/scan) fails *open* — the check-in still goes through, but
// this makes that fact visible instead of silently indistinguishable from a
// real MATCHED.
enum FaceVerifyStatus {
  NOT_CHECKED
  MATCHED
  MISMATCH
  UNAVAILABLE
}

model User {
  id           String @id @default(cuid())
  employeeCode String @unique // human-friendly ID, e.g. EMP001 / ADM001
  name         String
  email        String @unique
  role         Role   @default(EMPLOYEE)

  // Admin auth (only set for ADMIN role)
  passwordHash String?

  // Employee kiosk auth (only set for EMPLOYEE role)
  pinHash String?

  // WFH employees are geofenced against their own home location instead of
  // the office; FIELD employees skip geofencing entirely (see
  // /api/kiosk/scan). OFFICE (the default) is unaffected.
  workMode         WorkMode @default(OFFICE)
  homeLatitude     Float?
  homeLongitude    Float?
  homeRadiusMeters Float    @default(50)

  // Per-employee opt-in for face verification at check-in (see
  // /api/kiosk/scan and lib/faceVerify.ts). Off by default and only worth
  // switching on once this employee's reference photo has actually been
  // enrolled on the face-verification server — that enrollment happens
  // out-of-band (manually, on that server) rather than through this app, so
  // this flag is admin-set, not auto-derived.
  faceVerificationEnabled Boolean @default(false)

  active    Boolean  @default(true)
  // Set the moment an admin deactivates this employee (PATCH .../set-active)
  // — null while active. lib/employeeCleanup.ts's daily job uses this to
  // find who's been deactivated 7+ days and is due for archival + permanent
  // deletion (see DeletedEmployeeArchive). Cleared back to null on
  // reactivation, so the 7-day countdown restarts if deactivated again later.
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances      Attendance[]
  locationPings    LocationPing[]
  pushTokens       PushToken[]
  reimbursements   Reimbursement[]
  timeOffRequests  TimeOffRequest[]
  // One shift per weekday, at most — see ShiftAssignment. Replaces the old
  // single `shiftId` scalar so an employee can rotate between shifts across
  // the week (e.g. General Mon-Wed, Afternoon Thu-Fri) instead of having
  // exactly one shift for every day.
  shiftAssignments ShiftAssignment[]

  @@index([role])
  @@index([workMode])
}

// A named time slot (e.g. "General Shift", 09:00–18:00) an OFFICE employee
// can be assigned to on any subset of weekdays — see ShiftAssignment.
// startTime drives the lateness classification in /api/kiosk/scan; endTime
// is used for the stale-checkin/timed-permission auto-checkout.
model Shift {
  id        String   @id @default(cuid())
  name      String?
  startTime String // "HH:mm", 24-hour
  endTime   String // "HH:mm", 24-hour
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]
}

// Which Shift a given employee is on for a given day of the week — the join
// that replaced User.shiftId. Managed from the employee detail page's weekly
// schedule editor, one row per (userId, weekday) that actually has a shift
// assigned; a weekday with no row means no shift that day (lateness isn't
// tracked, same meaning as the old null shiftId). Resolving "today's shift"
// for a user is always `weekday = referenceDate.getDay()` — see
// lib/shiftAssignment.ts, the single place that does this lookup.
model ShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  // JS Date.getDay() convention: 0 = Sunday ... 6 = Saturday.
  weekday   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekday])
  @@index([shiftId])
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AttendanceType
  method    AttendanceMethod
  timestamp DateTime         @default(now())

  // Presence photo captured at check-in. `hasPhoto` is a cheap flag so list/
  // calendar views can decide whether to render a thumbnail without ever
  // pulling the (much larger) photo bytes into those queries. Photos older
  // than 45 days are opportunistically cleared (see scan route) — `hasPhoto`
  // is unset in lockstep so no page ever links to an expired image.
  photo    Bytes?
  hasPhoto Boolean @default(false)

  // Set only on CHECK_IN records, from the employee's shiftStartTime at the
  // moment of check-in (see /api/kiosk/scan). Null lateMinutes / NONE
  // leaveType means either on time, or the employee has no shiftStartTime
  // configured (lateness isn't tracked for them).
  lateMinutes Int?
  leaveType   LeaveType @default(NONE)

  // Result of the external face-verification call at check-in, when this
  // employee has faceVerificationEnabled — see lib/faceVerify.ts and
  // /api/kiosk/scan. faceSimilarity is the raw score the service returned
  // (kept for later threshold tuning), null whenever verification didn't
  // actually run.
  faceVerifyStatus   FaceVerifyStatus @default(NOT_CHECKED)
  faceSimilarity     Float?

  // Set only on CHECK_IN records for FIELD-workMode employees — the choice
  // they made that day (see /api/kiosk/scan). Null for OFFICE/WFH employees,
  // whose mode is already fixed on their profile.
  checkInMode CheckInMode?

  // Auto-pause (see /api/kiosk/location): pauseWarningAt marks the moment 3
  // consecutive out-of-range pings were confirmed, starting a 10-minute grace
  // period before an AttendancePause row is actually created. Cleared once
  // resolved either way (return to range, or converted into a real pause).
  pauseWarningAt DateTime?
  pauses         AttendancePause[]
  fieldVisits    FieldVisit[]
  timedPermissions TimedPermission[]
  workSegments     WorkSegment[]

  @@index([userId, timestamp])
}

enum TimedPermissionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A manually-entered request from an employee to pause their work-time
// tracking for a specific window during an active check-in (e.g. "2pm to
// 4pm") — distinct from the auto-computed lateMinutes/leaveType above, which
// only reflects lateness at check-in time, not a mid-day request. Requires
// admin approval before it can do anything — see /api/kiosk/location's
// evaluateTimedPermission, which only ever considers APPROVED rows; a
// PENDING or REJECTED permission never opens a pause. Approving one after
// its window has already started/ended still applies retroactively, since
// the pause-opening logic is purely ping-driven off startTime/endTime, not
// off when the approval happened.
model TimedPermission {
  id           String           @id @default(cuid())
  attendanceId String
  attendance   Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime         @default(now())
  pause        AttendancePause?

  approvalStatus TimedPermissionApprovalStatus @default(PENDING)
  reviewedAt     DateTime?
  // Snapshot of the reviewing admin's name at review time (same precedent as
  // Reimbursement.ratePerKm) rather than a live relation — keeps this model
  // from needing a back-reference on User for what's just an audit note.
  reviewedByName String?

  @@index([attendanceId])
  @@index([approvalStatus])
}

enum WorkSegmentStartMethod {
  // The mode the employee picked at check-in — always the first segment.
  CHECKIN
  // Confirmed geofence arrival/departure (see /api/kiosk/location's
  // evaluateWorkSegment) — same 3-consecutive-ping streak standard used
  // elsewhere, so a single stray GPS reading near the office never flips this.
  AUTO
  // The employee corrected it themselves — for when GPS detection is late,
  // wrong, or unavailable (e.g. indoors).
  MANUAL
}

// One entry in a FIELD-workMode employee's within-day timeline of Office vs
// Field time — replaces treating Attendance.checkInMode as fixed for the
// whole day. Only ever created for FIELD-profile employees; OFFICE/WFH
// employees have no concept of switching and never get one of these. Exactly
// one row per attendanceId has endedAt: null (the current, still-open
// segment) until checkout closes it. See /api/kiosk/location and
// /api/mobile/me/work-segment.
model WorkSegment {
  id           String                 @id @default(cuid())
  attendanceId String
  attendance   Attendance             @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  mode         CheckInMode
  startedAt    DateTime
  endedAt      DateTime?
  startMethod  WorkSegmentStartMethod

  @@index([attendanceId])
}

// A manually-logged stop during a Field day (see /api/mobile/field-visits) —
// distinct from PlaceNameCache/visited-places, which auto-infers stops from
// raw GPS pings. This is the employee's own record: a name, when they
// reached it, a photo, and where it was.
model FieldVisit {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  name         String
  reachedAt    DateTime   @default(now())
  photo        Bytes
  latitude     Float
  longitude    Float
  createdAt    DateTime   @default(now())

  @@index([attendanceId])
}

// A paused interval within one CHECK_IN session — resumedAt null means still
// paused. Kept as its own table (not new AttendanceType values) since several
// places assume exactly one CHECK_IN + one CHECK_OUT per employee per day.
model AttendancePause {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  pausedAt     DateTime
  resumedAt    DateTime?
  createdAt    DateTime   @default(now())

  // Set only when this pause was opened because of a TimedPermission
  // request rather than a detected geofence departure — lets
  // /api/kiosk/location (and any future admin display) tell the two apart.
  // Null == the ordinary geofence-departure auto-pause.
  timedPermissionId String?          @unique
  timedPermission   TimedPermission? @relation(fields: [timedPermissionId], references: [id])

  @@index([attendanceId])
}

// One row per device's Expo push token, used to warn an employee before
// their working time auto-pauses (see lib/pushNotifications.ts).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per live-location ping sent from an employee's kiosk tab while
// they're checked in (see /api/kiosk/location). Tracking is scoped to a
// single check-in session — the scan route's returned attendance id doubles
// as an unguessable capability token for that session's pings.
model LocationPing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

// Singleton-ish config: the scan route reads whichever row exists (there's
// normally just one) to geofence check-ins. No row yet == geofencing is off.
model OfficeLocation {
  id           String   @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Singleton app-wide config (see lib/settings.ts) — exactly one row, created
// on first read if missing. Start here for future toggles rather than adding
// more one-off models.
model AppSettings {
  id                    String   @id @default(cuid())
  checkOutPhotoRequired Boolean  @default(false)
  // Default ₹/km used to suggest a reimbursement amount (see
  // /api/admin/employees/[id]/reimbursement). Null == no default set yet;
  // admin can still enter an amount manually per day.
  reimbursementRatePerKm Float?

  // Annual leave quotas — global, same for every employee (see
  // TimeOffRequest). "Remaining" is always computed on the fly (quota minus
  // this year's APPROVED days for that type), never stored, so changing a
  // quota here never has to rewrite anyone's history.
  casualLeaveQuota Int @default(12)
  sickLeaveQuota   Int @default(6)
  earnedLeaveQuota Int @default(15)

  // The cutoff lib/shiftTime.ts's computeLateness uses to tell "Permission"
  // (minor lateness) apart from "Half-day leave" (major): a check-in up to
  // this many minutes after shift start is Permission; beyond it, Half-day.
  // Only ever read at the moment of check-in or when an admin edits a
  // check-in's time (see /api/kiosk/scan, /api/admin/attendance/[id]) —
  // changing this has no effect on already-computed leaveType/lateMinutes
  // on existing records, same precedent as the leave quotas above.
  lateThresholdMinutes Int @default(60)

  updatedAt DateTime @updatedAt
}

// A holiday that applies to everyone — excluded from a TimeOffRequest's day
// count (see TimeOffRequest.days) and shown in the leave calendar so a
// request spanning one isn't mistaken for a gap in the record.
model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
}

enum TimeOffType {
  CASUAL
  SICK
  EARNED
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Withdrawn by the employee themselves — only ever reachable from PENDING
  // (see /api/mobile/me/leave-requests/[id]). Kept as its own row, same as
  // REJECTED, rather than deleted, so it still shows in their history.
  CANCELLED
}

// A request for one or more whole calendar days off — distinct from
// TimedPermission (a same-day, hours-long pause during an active check-in)
// and unrelated to Attendance.leaveType (an auto-computed lateness
// classification, despite the similar name — see that field's own comment).
// Requires admin approval, same review pattern as TimedPermission.
model TimeOffRequest {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TimeOffType
  startDate DateTime
  endDate   DateTime
  // Calendar days in [startDate, endDate] minus any PublicHoliday dates,
  // snapshotted at submission time — a later change to the holiday calendar
  // must never silently change the cost of an already-decided request.
  days   Int
  reason String?

  status         TimeOffRequestStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedByName String?
  // Only ever set alongside a REJECTED decision — an admin's optional note
  // on why, surfaced to the employee in the decline notification and in
  // their own request history.
  reviewNote String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([userId, startDate, endDate])
}

// One row per employee per calendar day — admin enters/edits this from the
// Field workers panel. ratePerKm and distanceKm are snapshotted at save time
// so a later change to the default rate never rewrites history.
model Reimbursement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  distanceKm Float
  ratePerKm  Float
  amount     Float
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// Reverse-geocoding memoization — coordinates rounded to 3 decimal places
// (~111m grid) before lookup/storage, so nearby pings within the same
// cluster share one Nominatim call. Never expires: place names for a fixed
// location don't change, and Nominatim's usage policy expects this kind of
// caching, not repeat lookups (see lib/geocoding.ts).
model PlaceNameCache {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  placeName String
  createdAt DateTime @default(now())

  @@unique([latitude, longitude])
}

// The only surviving record of an employee once lib/employeeCleanup.ts
// permanently deletes them (7+ days after deactivation) — the delete itself
// cascades away their User row and everything under it (Attendance,
// Reimbursement, TimeOffRequest, ShiftAssignment, LocationPing, FieldVisit,
// ...), so this snapshot is taken and saved in the *same transaction* as
// that delete, never after. CSV text, not a live relation, on purpose: it
// must keep meaning something even though the rows it describes are gone.
// See app/admin/employees/deleted/page.tsx for where an admin can still
// read/download this.
model DeletedEmployeeArchive {
  id            String   @id @default(cuid())
  employeeCode  String
  name          String
  email         String
  workMode      WorkMode
  deactivatedAt DateTime
  deletedAt     DateTime @default(now())

  attendanceCsv    String
  reimbursementCsv String
  leaveRequestsCsv String

  @@index([deletedAt])
}
