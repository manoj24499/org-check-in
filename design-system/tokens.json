{
  "brand": {
    "name": "Inzivo",
    "logo": "Z-gate mark — top bar, bottom bar, orange diagonal stroke between them"
  },
  "color": {
    "background": "#FBF9F7",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F4F1ED",
    "border": "rgba(26,21,18,0.10)",

    "primary": "#ef6c00",
    "primaryDark": "#C25200",
    "primaryMuted": "rgba(239,108,0,0.10)",
    "primaryText": "#FFFFFF",
    "primarySoftText": "#F7B27A",

    "success": "#2E6F52",
    "successMuted": "rgba(46,111,82,0.10)",
    "warning": "#B8860B",
    "warningMuted": "rgba(184,134,11,0.10)",
    "danger": "#B3453F",
    "dangerMuted": "rgba(179,69,63,0.10)",

    "textPrimary": "#1A1512",
    "textSecondary": "#86776F",
    "textMuted": "#A0938B",
    "textInverse": "#FFFFFF",

    "panelDark": "#241E19",
    "panelDarker": "#231D18",
    "textOnDark": "#F7F3EF",
    "textOnDarkMuted": "rgba(247,243,239,0.6)",

    "overlay": "rgba(26,21,18,0.55)"
  },
  "typography": {
    "fontFamily": "Inter",
    "weights": { "regular": 400, "medium": 500, "semiBold": 600, "bold": 700 },
    "scale": {
      "h1": { "fontSize": 28, "weight": 700, "lineHeight": 34 },
      "h2": { "fontSize": 22, "weight": 700, "lineHeight": 28 },
      "h3": { "fontSize": 18, "weight": 600, "lineHeight": 24 },
      "body": { "fontSize": 15, "weight": 400, "lineHeight": 22 },
      "bodyStrong": { "fontSize": 15, "weight": 600, "lineHeight": 22 },
      "caption": { "fontSize": 13, "weight": 400, "lineHeight": 18 },
      "label": { "fontSize": 13, "weight": 600, "lineHeight": 18 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 14,
    "full": 999,
    "_note": "xl (14) is a distinct sheet/dialog-corner value from the Inzivo Redesign mockup, not part of the sm<md<lg progression — used only for bottom sheets and blocking dialogs."
  },
  "buttons": {
    "rule": "Primary actions are outlined, not filled. Solid fill is reserved for dark presence panels only.",
    "minHeight": 50,
    "variants": {
      "primary": { "background": "transparent", "border": "1px solid primary", "text": "primary" },
      "secondary": { "background": "surfaceMuted", "border": "none", "text": "textPrimary" },
      "danger": { "background": "transparent", "border": "1px solid danger", "text": "danger" },
      "ghost": { "background": "transparent", "border": "none", "text": "primary" }
    }
  }
}
